parameters:
    level: max
    phpVersion: 80300
    paths:
        - ../infrastructure/ReadinessBudget.php
        - ../infrastructure/ReadinessPolicy.php
        - ../infrastructure/ReadinessAdmission.php
        - ../infrastructure/CoreReadinessProbe.php
