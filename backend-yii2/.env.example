APP_ENV=development
DATABASE_URL=postgres://shopkmp:replace-me@postgres:5432/shopkmp?sslmode=disable
OPENSEARCH_URL=http://opensearch:9200
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_ALLOWED_CIDRS=
CORS_ALLOWED_ORIGINS=
# Exact allocated Go BFF peers only; internal Nginx owns the rate context header.
TRUSTED_BFF_IPS=172.30.95.4
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=720h
ORDER_PENDING_TTL=15m
ORDER_AUTHORIZED_TTL=2h
IDEMPOTENCY_RETENTION=24h
JSON_BODY_LIMIT_BYTES=1048576
WEBHOOK_BODY_LIMIT_BYTES=1048576
AVATAR_BODY_LIMIT_BYTES=5242880
WEBHOOK_MAX_AGE=5m
READINESS_TIMEOUT=2s
# Duration values also support millisecond units, for example READINESS_TIMEOUT=500ms.
MUTATION_RATE_LIMIT=120
SENSITIVE_RATE_LIMIT=20
READ_RATE_LIMIT=300
SEARCH_RATE_LIMIT=30
AUTHENTICATED_NETWORK_RATE_LIMIT_MULTIPLIER=4
RATE_LIMIT_WINDOW=1m
PIN_MAX_ATTEMPTS=5
PIN_LOCK_DURATION=15m
PIN_MAX_LOCKS=3
BIOMETRIC_MAX_LOCKS=3
