# Copy to .env.prod. Empty required values deliberately fail validation.
COMPOSE_PROJECT_NAME=shopkmp-production
APP_ENV=production
EDGE_BIND=0.0.0.0
EDGE_TLS_PORT=443
EDGE_SUBNET=172.30.96.0/24
EDGE_IP=172.30.96.2
YII_HTTP_IP=172.30.96.3
SDUI_IP=172.30.96.4
PUBLIC_API_HOST=
TLS_CERT_DIR=
# PEM bundle containing internal CA and the payment provider's trusted root(s).
CA_BUNDLE_FILE=
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
OPENSEARCH_ADMIN_PASSWORD=
PAYMENT_WEBHOOK_SECRET=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_EMAILS=
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_ALLOWED_CIDRS=
CORS_ALLOWED_ORIGINS=
MAINTENANCE_JOB_TIMEOUT_SECONDS=120
REINDEX_JOB_TIMEOUT_SECONDS=1800
MAINTENANCE_SUCCESS_MAX_AGE_SECONDS=
REINDEX_SUCCESS_MAX_AGE_SECONDS=
