# Copy to .env.prod. Empty required values deliberately fail validation.
COMPOSE_PROJECT_NAME=shopkmp-production
APP_ENV=production
EDGE_BIND=0.0.0.0
EDGE_TLS_PORT=443
EDGE_SUBNET=172.30.96.0/24
EDGE_IP=172.30.96.2
YII_HTTP_IP=172.30.96.3
SDUI_IP=172.30.96.4
# Exact allocated BFF ingress addresses, comma-separated; keep aligned with SDUI_IP.
TRUSTED_BFF_IPS=172.30.96.4
YII_FPM_SUBNET=172.30.97.0/24
YII_FPM_HTTP_IP=172.30.97.3
# Keep dynamic FPM clients outside the fixed Nginx peer address.
YII_FPM_DYNAMIC_RANGE=172.30.97.128/25
PUBLIC_API_HOST=
TLS_CERT_DIR=
# PEM bundle containing internal CA and the payment provider's trusted root(s).
CA_BUNDLE_FILE=
POSTGRES_PASSWORD=
# Distinct SQL login secrets. Supply via the deployment secret store/environment;
# never commit the populated environment file. No runtime fallback to the DBA.
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_OPERATOR_PASSWORD=
POSTGRES_SEARCH_PASSWORD=
POSTGRES_INDEXER_PASSWORD=
POSTGRES_MAINTENANCE_PASSWORD=
POSTGRES_RECOVERY_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_ALLOWED_CIDRS=
CORS_ALLOWED_ORIGINS=
MAINTENANCE_JOB_TIMEOUT_SECONDS=120
REINDEX_JOB_TIMEOUT_SECONDS=1800
MAINTENANCE_SUCCESS_MAX_AGE_SECONDS=
REINDEX_SUCCESS_MAX_AGE_SECONDS=
RECOVERY_JOB_TIMEOUT_SECONDS=120
RECOVERY_SUCCESS_MAX_AGE_SECONDS=
