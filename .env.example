# LOCAL DEVELOPMENT ONLY. cp .env.example .env && make run
COMPOSE_PROJECT_NAME=shopkmp-migrated
APP_ENV=development
EDGE_BIND=127.0.0.1
EDGE_PORT=8080
EDGE_SUBNET=172.30.95.0/24
EDGE_IP=172.30.95.2
YII_HTTP_IP=172.30.95.3
SDUI_IP=172.30.95.4
# Exact allocated BFF ingress addresses, comma-separated; keep aligned with SDUI_IP.
TRUSTED_BFF_IPS=172.30.95.4
YII_FPM_SUBNET=172.30.94.0/24
YII_FPM_HTTP_IP=172.30.94.3
# Optional allocation range excluding the fixed Nginx peer, for stop/recreate runs.
YII_FPM_DYNAMIC_RANGE=172.30.94.128/25
POSTGRES_PASSWORD=DevDatabase7395
PAYMENT_WEBHOOK_SECRET=DevWebhookSecret7395
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_ALLOWED_CIDRS=
CORS_ALLOWED_ORIGINS=
# Worker budgets; blank success age defaults to interval + job budget + 5 seconds.
MAINTENANCE_JOB_TIMEOUT_SECONDS=120
REINDEX_JOB_TIMEOUT_SECONDS=1800
MAINTENANCE_SUCCESS_MAX_AGE_SECONDS=
REINDEX_SUCCESS_MAX_AGE_SECONDS=
RECOVERY_JOB_TIMEOUT_SECONDS=120
RECOVERY_SUCCESS_MAX_AGE_SECONDS=
