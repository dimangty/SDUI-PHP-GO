log_format edge '$remote_addr "$request_method $uri" $status $request_time $request_id';
access_log /dev/stdout edge;
server {
    listen 8443 ssl default_server;
    listen [::]:8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name ${PUBLIC_API_HOST};
    ssl_certificate /run/tls/api.crt;
    ssl_certificate_key /run/tls/api.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/routes.conf;
    location ^~ /swagger { return 404; }
    location ^~ /health { return 404; }
    location ^~ /metrics { return 404; }
}
server {
    listen 8090;
    server_name _;
    location = /live { access_log off; return 200 'ok'; }
    location / { return 404; }
}
